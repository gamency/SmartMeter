<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- 顶部 Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        style="@style/SmartMeterToolbar">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="智能抄表"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tv_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已拍 0/12"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />

    </androidx.appcompat.widget.Toolbar>

    <View style="@style/SmartMeterDivider" />

    <!-- 选择器行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- 房间 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="房间"
                android:textSize="14sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_selected_room"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="电梯"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                android:drawableEnd="@drawable/ic_chevron_down"
                android:drawablePadding="4dp" />
        </LinearLayout>

        <!-- 表型 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="表型"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginEnd="8dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_type_electric"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="16dp"
                    android:text="⚡"
                    android:textSize="14sp"
                    android:backgroundTint="@color/primary"
                    android:textColor="@color/surface"
                    android:radius="18dp"
                    android:stateListAnimator="@null" />

                <Button
                    android:id="@+id/btn_type_cold"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="16dp"
                    android:text="💧"
                    android:textSize="14sp"
                    android:backgroundTint="#F1F5F9"
                    android:textColor="@color/text_secondary"
                    android:radius="18dp"
                    android:stateListAnimator="@null"
                    android:layout_marginStart="8dp" />

                <Button
                    android:id="@+id/btn_type_hot"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:paddingHorizontal="16dp"
                    android:text="🔥"
                    android:textSize="14sp"
                    android:backgroundTint="#F1F5F9"
                    android:textColor="@color/text_secondary"
                    android:radius="18dp"
                    android:stateListAnimator="@null"
                    android:layout_marginStart="8dp" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- 中间区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp">

        <!-- 上次读数卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#F1F5F9"
            android:padding="16dp"
            android:radius="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="上次读数"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tv_last_reading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12,345"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="请对准表盘，保持光线充足"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <!-- 已拍记录列表（weight=1撑满剩余空间） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_records"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:clipToPadding="false" />

    <!-- 底部固定区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:elevation="8dp">

        <!-- 在线状态 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginEnd="16dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@color/success"
                android:radius="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="在线"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <!-- 拍照按钮 -->
        <Button
            android:id="@+id/btn_take_photo"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:text="📷 拍照识别"
            android:textSize="16sp"
            android:backgroundTint="@color/primary"
            android:textColor="@color/surface"
            android:radius="28dp"
            android:elevation="4dp"
            android:stateListAnimator="@null" />

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <!-- ===== 顶部导航 ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/padding_page"
        android:paddingEnd="@dimen/padding_page"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:background="@color/bg_page">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="电表抄表录入"
            style="@style/TextTitle" />

        <TextView
            android:id="@+id/btn_cached"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:text="缓存记录"
            android:textColor="@color/primary_blue"
            android:textSize="14sp" />

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- ===== 可滚动内容 ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/padding_page"
        android:paddingEnd="@dimen/padding_page"
        android:paddingTop="@dimen/space_card_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. 房间选择卡片（单行紧凑布局） -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CardStyle"
                android:layout_marginBottom="@dimen/space_card_vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="选择房间："
                        style="@style/TextBody"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tv_selected_room"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="请选择"
                        style="@style/TextBody"
                        android:textColor="@color/primary_blue"
                        android:padding="8dp"
                        android:drawableEnd="@drawable/ic_arrow_down"
                        android:drawablePadding="4dp"
                        android:layout_marginStart="8dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. 拍照录入核心卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CardStyle"
                android:layout_marginBottom="@dimen/space_card_vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btn_take_photo"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/height_button_large"
                        android:text="拍摄电表读数"
                        style="@style/ButtonPrimary"
                        android:enabled="false" />

                    <TextView
                        android:id="@+id/tv_photo_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="请先选择抄表房间"
                        style="@style/TextSmall"
                        android:layout_marginTop="@dimen/space_small" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. 待上传缓存记录卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CardStyle"
                android:layout_marginBottom="80dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="待上传抄表记录"
                        style="@style/TextTitle"
                        android:layout_marginBottom="@dimen/space_small" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_cached"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/tv_empty_cached"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="暂无缓存抄表数据，点击上方按钮拍摄电表录入"
                        style="@style/TextSmall"
                        android:gravity="center"
                        android:paddingVertical="20dp"
                        android:visibility="gone" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- ===== 底部固定提交按钮 ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/padding_page"
        android:paddingEnd="@dimen/padding_page"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:background="@color/bg_card">

        <Button
            android:id="@+id/btn_submit_all"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_large"
            android:text="批量提交全部缓存数据"
            style="@style/ButtonPrimary"
            android:enabled="false" />

        <TextView
            android:id="@+id/tv_network_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:text="当前无网络，数据已本地缓存"
            style="@style/TextSmall"
            android:gravity="center"
            android:paddingTop="8dp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- 顶部时间栏 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:background="@color/surface">

        <TextView
            android:id="@+id/update_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="更新中..."
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />
    </FrameLayout>

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 可滚动内容 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 日期筛选器 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:background="@color/surface"
                android:layout_marginBottom="16dp"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tag_month"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:minWidth="60dp"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:gravity="center"
                                android:text="本月"
                                android:textSize="14sp"
                                android:background="@drawable/bg_filter_chip"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/tag_last_month"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:minWidth="60dp"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:gravity="center"
                                android:text="上月"
                                android:textSize="14sp"
                                android:background="@drawable/bg_filter_chip"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/tag_30d"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:minWidth="60dp"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:gravity="center"
                                android:text="近30天"
                                android:textSize="14sp"
                                android:background="@drawable/bg_filter_chip"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/tag_90d"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:minWidth="60dp"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:gravity="center"
                                android:text="近90天"
                                android:textSize="14sp"
                                android:background="@drawable/bg_filter_chip"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/btn_custom_date"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:minWidth="60dp"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:gravity="center"
                                android:text="自定义"
                                android:textSize="14sp"
                                android:background="@drawable/bg_filter_chip" />

                        </LinearLayout>
                    </HorizontalScrollView>

                    <TextView
                        android:id="@+id/tv_period"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2026-07-01 ~ 2026-07-13"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="8dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 用电总览卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:background="@color/surface"
                android:layout_marginBottom="16dp"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="区间用电总览"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tv_total_usage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0 度"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:gravity="center"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_tenant_usage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="租户承担 0 度"
                            android:textSize="14sp"
                            android:textColor="@color/success" />

                        <TextView
                            android:id="@+id/tv_landlord_usage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="房东承担 0 度"
                            android:textSize="14sp"
                            android:textColor="@color/primary" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 供电局对账卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:background="@color/surface"
                android:layout_marginBottom="16dp"
                android:padding="16dp"
                android:id="@+id/card_reconciliation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="供电局读数对账"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="供电局同期总电量"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tv_power_kwh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 度"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="本人抄表汇总电量"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tv_meter_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 度"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_diff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:background="@drawable/bg_diff_normal"
                        android:radius="8dp"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="用电差值"
                            android:textSize="14sp"
                            android:textColor="@color/text_secondary" />

                        <TextView
                            android:id="@+id/tv_diff_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 度"
                            android:textSize="14sp"
                            android:textColor="@color/text_primary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_diff_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="理想状态下两者数值基本持平"
                        android:textSize="12sp"
                        android:textColor="@color/text_secondary" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- TOP10租户卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:background="@color/surface"
                android:layout_marginBottom="80dp"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="本期用电TOP10租户"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/tv_view_full"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="查看完整账单 →"
                            android:textSize="14sp"
                            android:textColor="@color/primary" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/distribution_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tv_empty_tenant"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="本期所有租户用电平稳，无异常高耗电"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:paddingVertical="20dp"
                        android:visibility="gone" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 近30天趋势 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                android:background="@color/surface"
                android:layout_marginBottom="16dp"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="近30天日总用电趋势"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:id="@+id/trend_container"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:paddingTop="8dp"
                        android:clipChildren="false" />

                    <TextView
                        android:id="@+id/tv_trend_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="暂无数据"
                        android:textSize="14sp"
                        android:textColor="@color/text_secondary"
                        android:gravity="center"
                        android:paddingVertical="16dp"
                        android:visibility="gone" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_page">

    <!-- 顶部悬浮导航 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/padding_page"
        android:paddingEnd="@dimen/padding_page"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:background="@color/bg_page">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="用电统计总览"
            style="@style/TextTitle" />

        <ImageView
            android:id="@+id/iv_more"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical|end"
            android:src="@drawable/ic_more"
            android:padding="4dp" />
    </FrameLayout>

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- 可滚动内容 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="@dimen/padding_page"
        android:paddingEnd="@dimen/padding_page"
        android:paddingTop="@dimen/space_card_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. 日期筛选卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CardStyle"
                android:layout_marginBottom="@dimen/space_card_vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="筛选周期"
                        style="@style/TextTitle"
                        android:layout_marginBottom="@dimen/space_small" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="@dimen/space_small">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingVertical="4dp">

                            <TextView
                                android:id="@+id/tag_month"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="本月"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="6dp"
                                android:background="@drawable/bg_filter_tag"
                                android:textColor="#FFFFFF"
                                android:textSize="13sp"
                                android:layout_marginEnd="@dimen/space_small" />

                            <TextView
                                android:id="@+id/tag_last_month"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="上月"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="6dp"
                                android:background="@drawable/bg_filter_tag"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:layout_marginEnd="@dimen/space_small" />

                            <TextView
                                android:id="@+id/tag_30d"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="近30天"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="6dp"
                                android:background="@drawable/bg_filter_tag"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:layout_marginEnd="@dimen/space_small" />

                            <TextView
                                android:id="@+id/tag_90d"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="近90天"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="6dp"
                                android:background="@drawable/bg_filter_tag"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp" />

                        </LinearLayout>
                    </HorizontalScrollView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_period"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="2026-07-01 ~ 2026-07-12"
                            style="@style/TextSmall" />

                        <TextView
                            android:id="@+id/btn_custom_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="自定义"
                            android:textSize="13sp"
                            android:textColor="@color/primary_blue"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:background="@drawable/bg_button_secondary" />

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. 区间用电总览卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CardStyle"
                android:layout_marginBottom="@dimen/space_card_vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="区间用电总览"
                        style="@style/TextTitle"
                        android:layout_marginBottom="@dimen/space_small" />

                    <TextView
                        android:id="@+id/tv_total_usage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="0 度"
                        style="@style/TextLarge"
                        android:gravity="center"
                        android:layout_marginBottom="@dimen/space_item" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp">

                            <TextView
                                android:id="@+id/tv_tenant_usage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 度"
                                style="@style/TextLarge" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="全部出租房间合计用电"
                                style="@style/TextSmall" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/divider" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:background="@color/primary_blue_light"
                            android:paddingVertical="8dp"
                            android:radius="8dp">

                            <TextView
                                android:id="@+id/tv_landlord_usage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 度"
                                style="@style/TextLarge" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="公共区域/自住/自营商铺用电"
                                style="@style/TextSmall" />
                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginTop="@dimen/space_item" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. 供电局读数对账卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CardStyle"
                android:layout_marginBottom="@dimen/space_card_vertical"
                android:id="@+id/card_reconciliation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="供电局读数对账"
                        style="@style/TextTitle"
                        android:layout_marginBottom="@dimen/space_small" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/space_small">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="供电局同期总电量"
                            style="@style/TextBody" />

                        <TextView
                            android:id="@+id/tv_power_kwh"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 度"
                            style="@style/TextBody" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/space_small">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="本人抄表汇总电量"
                            style="@style/TextBody" />

                        <TextView
                            android:id="@+id/tv_meter_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 度"
                            style="@style/TextBody" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_diff"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:background="@drawable/bg_diff_normal"
                        android:radius="8dp"
                        android:layout_marginBottom="@dimen/space_small">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="用电差值"
                            style="@style/TextBody" />

                        <TextView
                            android:id="@+id/tv_diff_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0 度"
                            style="@style/TextLarge" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_diff_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="理想状态下两者数值基本持平"
                        style="@style/TextSmall" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 4. TOP10租户卡片 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CardStyle"
                android:layout_marginBottom="80dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本期用电TOP10租户"
                        style="@style/TextTitle"
                        android:layout_marginBottom="@dimen/space_small" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_top_ten"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                    <TextView
                        android:id="@+id/tv_empty_tenant"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="本期所有租户用电平稳，无异常高耗电"
                        style="@style/TextSmall"
                        android:gravity="center"
                        android:paddingVertical="20dp"
                        android:visibility="gone" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
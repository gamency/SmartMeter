<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="start"
    android:paddingVertical="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:maxWidth="280dp"
        android:background="@drawable/bg_chat_assistant"
        android:padding="12dp"
        android:layout_marginEnd="48dp">

        <!-- 正文内容 -->
        <TextView
            android:id="@+id/tv_assistant_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#333333"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp" />

        <!-- 时间 -->
        <TextView
            android:id="@+id/tv_assistant_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10sp"
            android:textColor="#B0BEC5"
            android:layout_marginTop="4dp"
            android:layout_gravity="end" />

        <!-- ===== 思考过程（折叠） ===== -->
        <LinearLayout
            android:id="@+id/ll_thinking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <!-- 折叠按钮 -->
            <TextView
                android:id="@+id/tv_thinking_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💭 思考过程 ▶"
                android:textSize="12sp"
                android:textColor="#888888"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground" />

            <!-- 思考内容（可展开） -->
            <LinearLayout
                android:id="@+id/ll_thinking_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_thinking_steps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="#666666"
                    android:lineSpacingExtra="2dp"
                    android:fontFamily="monospace" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F5F7FA">

    <!-- 标题 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📷 智能抄表"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E"
        android:layout_marginBottom="12dp" />

    <!-- 房间选择 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="2dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="房间："
            android:textSize="14sp"
            android:textColor="#1A1A2E" />

        <Spinner
            android:id="@+id/roomSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/lastReadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="上月: --"
            android:textSize="12sp"
            android:textColor="#9CA3AF" />
    </LinearLayout>

    <!-- ===== 新增：表类型选择 ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="2dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="表类型："
            android:textSize="14sp"
            android:textColor="#1A1A2E" />

        <Spinner
            android:id="@+id/resourceTypeSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:entries="@array/resource_types" />
    </LinearLayout>

    <!-- 拍照按钮 -->
    <Button
        android:id="@+id/takePhotoBtn"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="📸 拍照"
        android:textSize="18sp"
        android:backgroundTint="#4A6CF7"
        android:layout_marginBottom="16dp" />

    <!-- 已拍列表标题 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="已拍记录"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E"
        android:layout_marginBottom="8dp" />

    <!-- 已拍列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/pendingRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- 同步按钮 -->
    <Button
        android:id="@+id/syncBtn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="🔄 一键同步"
        android:textSize="16sp"
        android:backgroundTint="#22C55E"
        android:layout_marginTop="12dp" />

</LinearLayout>